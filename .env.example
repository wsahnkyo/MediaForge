MEDIAFORGE_DATABASE_URL=postgresql+psycopg://mediaforge:CHANGE_ME@127.0.0.1:5432/mediaforge
# Create the first admin with: mediaforge create-admin --username admin
MEDIAFORGE_SESSION_HOURS=12
# Enable when later deploying behind an HTTPS reverse proxy.
MEDIAFORGE_COOKIE_SECURE=false
# UTF-8 runtime log. Rotate daily or at the size limit; restart after changing.
MEDIAFORGE_LOG_PATH=.\logs\mediaforge.log
MEDIAFORGE_LOG_RETENTION_DAYS=7
MEDIAFORGE_LOG_MAX_TOTAL_MB=1024
MEDIAFORGE_LOG_MAX_FILE_MB=50
# JSON array. Only existing, explicitly configured directories are accessible.
MEDIAFORGE_MEDIA_ROOTS=["D:\\Media"]
# Default: generated preview file, NOT the Windows system hosts file.
MEDIAFORGE_HOSTS_PATH=.\data\hosts.preview
MEDIAFORGE_HOSTS_ALLOW_SYSTEM=false
# 0 disables automatic updates. Otherwise at least 60 seconds.
MEDIAFORGE_HOSTS_INTERVAL_SECONDS=0
# dns: local DNS + TLS probes; checktmdb: download both IPv4/IPv6 subscriptions.
# This is the default/manual and scheduled source; the page can override one manual run.
MEDIAFORGE_HOSTS_SOURCE=dns
MEDIAFORGE_DNS_SERVERS=["1.1.1.1","8.8.8.8"]
MEDIAFORGE_DNS_PROVIDERS=["google","cloudflare","alidns","dns"]
MEDIAFORGE_DNS_ATTEMPTS=2
# Resolve common GitHub domains too. Never blindly import a third-party hosts file.
MEDIAFORGE_HOSTS_INCLUDE_GITHUB=true
MEDIAFORGE_IP_FAMILY=ipv4
# Defaults include the deduplicated CheckTMDB media domain list.
# MEDIAFORGE_HOSTS_DOMAINS=["api.themoviedb.org","image.tmdb.org"]
